<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_motivation_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Header: accent bar + small caps label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="4dp"
            android:background="@drawable/widget_motivation_accent"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.75"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:text="@string/motivation_widget_label"
            android:textAllCaps="true"
            android:textColor="#FFFFC371"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- The quote itself -->
    <TextView
        android:id="@+id/quote_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="6"
        android:paddingEnd="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="italic" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/favorite_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_motivation_btn"
            android:contentDescription="@string/motivation_favorite"
            android:gravity="center"
            android:text="&#9734;"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_motivation_btn"
            android:contentDescription="@string/motivation_new_quote"
            android:gravity="center"
            android:text="&#8635;"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
